# Public canonical origin; safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only PostgreSQL connection. Use a dedicated Astron DB and role.
# On Contabo, prefer the private Docker network (host: postgres), never a public DB port.
DATABASE_URL=postgresql://astron_app:change_me@localhost:5432/astron_invitations
# disable only on a trusted private network; use require with certificate validation for TLS.
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
